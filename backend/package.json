{
  "name": "smart-home-backend",
  "version": "1.0.0",
  "description": "REST API + SQLite database for the Smart Home app (no npm dependencies)",
  "main": "src/server.js",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/seed.js --reset",
    "simulate": "node scripts/simulate-sensors.js",
    "test": "node --test tests/api.test.js"
  }
}
