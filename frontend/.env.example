# Copy this file to ".env" and set the address of your running backend.
# Restart Expo after changing it (npx expo start -c).
#
#   Web / iOS simulator : http://localhost:3000/api
#   Android emulator    : http://10.0.2.2:3000/api
#   Real phone (same Wi-Fi): http://<your-computer-LAN-IP>:3000/api   e.g. http://192.168.1.20:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api
